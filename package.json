{
  "name": "@sontakey/ppg-js",
  "version": "0.3.0",
  "description": "Camera PPG in the browser: heart rate, pulse-rate variability, respiration and signal quality from a fingertip on a phone camera. Zero dependencies, typed, no UI.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dsp": {
      "import": {
        "types": "./dist/dsp.d.ts",
        "default": "./dist/dsp.js"
      },
      "require": {
        "types": "./dist/dsp.d.cts",
        "default": "./dist/dsp.cjs"
      }
    },
    "./hrv": {
      "import": {
        "types": "./dist/hrv.d.ts",
        "default": "./dist/hrv.js"
      },
      "require": {
        "types": "./dist/hrv.d.cts",
        "default": "./dist/hrv.cjs"
      }
    },
    "./sources": {
      "import": {
        "types": "./dist/sources.d.ts",
        "default": "./dist/sources.js"
      },
      "require": {
        "types": "./dist/sources.d.cts",
        "default": "./dist/sources.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "require": {
        "types": "./dist/engine.d.cts",
        "default": "./dist/engine.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node tools/postbuild.mjs",
    "build:site": "npm run build && node tools/stamp-examples.mjs",
    "dev": "tsup --watch",
    "serve": "python3 -m http.server 8080",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node test/run-all.js",
    "test:unit": "node test/run-all.js",
    "test:e2e": "node test/e2e/fake-camera.mjs",
    "replay": "tsx tools/replay.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "biometrics",
    "camera",
    "getusermedia",
    "health",
    "heart-rate",
    "hrv",
    "ibi",
    "photoplethysmography",
    "ppg",
    "prv",
    "pulse-rate-variability",
    "respiration",
    "rmssd",
    "signal-processing",
    "signal-quality",
    "typescript",
    "vitals",
    "webrtc"
  ],
  "author": "Sameer Sontakey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sontakey/ppg-js.git"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "playwright": "^1.56.1"
  },
  "homepage": "https://github.com/sontakey/ppg-js#readme",
  "bugs": {
    "url": "https://github.com/sontakey/ppg-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js"
}
